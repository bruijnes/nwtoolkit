<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows executable: the command line from nwtoolkit.Core plus the native WPF
    window (Fluent theme, light and dark follow the Windows app-mode setting). It is a
    console-subsystem exe on purpose: started from a terminal it behaves like any CLI
    tool; double-clicked it detaches from its console and shows the window.

    Publish (self-contained, one file, no .NET install needed on the target):
      dotnet publish src/nwtoolkit -c Release -o dist
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <RootNamespace>Nwtoolkit</RootNamespace>
    <AssemblyName>nwtoolkit</AssemblyName>
    <ApplicationIcon>nwtoolkit.ico</ApplicationIcon>
    <ApplicationManifest>nwtoolkit.manifest</ApplicationManifest>
    <StartupObject>Nwtoolkit.Program</StartupObject>
    <!--
      Directory.Build.props switches globalization to invariant mode for the library and
      the tests, but WPF needs real culture data (it looks up "en-US" for bindings and
      text formatting) and Windows ships ICU, so the exe runs with globalization on.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WPF0001: the ThemeMode API (Fluent theme, light/dark) is still marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- lets Linux/macOS build and publish the Windows target (CI runs on ubuntu) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- publish defaults: one self-contained exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseAppHost>true</UseAppHost>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!--
      Trimming halves the exe by dropping the parts of the runtime this app never
      touches. WPF itself is not trimmable and stays intact; only the framework
      libraries are trimmed. The SDK refuses trimming for WPF apps by default, hence
      the suppression. If a control ever misbehaves after publishing, this block is
      the first thing to switch off.
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
    <!-- trimming switches built-in COM interop off; WPF needs it for DirectWrite (fonts) and more -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\nwtoolkit.Core\nwtoolkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The XAML loader finds type converters through reflection, which the trimmer
      cannot see. Keep the assemblies that hold them in full, otherwise a converter
      such as UriTypeConverter is missing at run time and the window fails to load.
    -->
    <TrimmerRootAssembly Include="System.ComponentModel.TypeConverter" />
    <TrimmerRootAssembly Include="System.ComponentModel.Primitives" />
    <TrimmerRootAssembly Include="System.ObjectModel" />
    <TrimmerRootAssembly Include="System.Private.Uri" />
  </ItemGroup>

  <ItemGroup>
    <!-- the icon is also a WPF resource so the window can show it -->
    <Resource Include="nwtoolkit.ico" />
  </ItemGroup>

  <!--
    Files the runtime packs put in the bundle that this app never loads:
    - WPF theme assemblies for XP, Media Center and Windows 7 (Windows 10 and 11 only
      ever load Aero2, Classic and AeroLite) and the Ribbon control library;
    - debugger and crash-dump support (mscordaccore, mscordbi, DiaSymReader), which
      only matter with a debugger attached or symbols present;
    - the standalone GC builds (clrgc, clrgcexp), only used when selected by config;
    - msquic, only loaded for HTTP/3.
    Dropping them takes about 9 MB off the uncompressed bundle.
  -->
  <Target Name="DropUnusedBundleFiles" AfterTargets="ComputeResolvedFilesToPublishList" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <_Keep Include="@(ResolvedFileToPublish)" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" />
      <ResolvedFileToPublish Include="@(_Keep)" Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(PresentationFramework\.(Luna|Royale|Aero)|System\.Windows\.Controls\.Ribbon|mscordaccore.*|mscordbi|Microsoft\.DiaSymReader\.Native\.amd64|clrgc|clrgcexp|msquic)$'))" />
    </ItemGroup>
  </Target>

</Project>
